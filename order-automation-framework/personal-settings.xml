<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">

    <!--
        Personal-project settings, isolated from the corporate Maven config.
        Use a separate local repository so nothing here mixes with the
        company's cached/mirrored artifacts, and no <mirror> entry, so
        Maven falls back to its default Central repo
        (https://repo.maven.apache.org/maven2) directly instead of going
        through archiva-new.prod.internal.

        Usage: mvn -s personal-settings.xml clean test
    -->

    <localRepository>${user.home}/.m2/repository-personal</localRepository>

</settings>
